# ─────────────────────────────────────────────
#  MENTALIZE BACKEND — variáveis de ambiente
#  Copie este arquivo para .env e preencha.
# ─────────────────────────────────────────────

# ── Banco de dados ──────────────────────────
# Cole aqui a Connection String do Supabase (ou outro PostgreSQL).
# Supabase: Project Settings → Database → Connection string → URI
# Formato: postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.XXXX.supabase.co:5432/postgres


# ── Autenticação JWT ─────────────────────────
# Gere uma string aleatória longa: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-string-secreta-e-longa

# ── Servidor ─────────────────────────────────
PORT=3000
NODE_ENV=development   # ou production

# Sessão (milissegundos) — padrão 8 horas
# SESSION_MAX_AGE_MS=28800000

# ── CORS ─────────────────────────────────────
# Em desenvolvimento o padrão já permite localhost:5173.
# Em produção, informe a URL exata do frontend (sem barra final).
# CORS_ORIGIN=https://meusite.vercel.app

# ── Rate limiting (opcional) ─────────────────
# API_RATE_LIMIT=600
# AUTH_RATE_LIMIT=20
